{
  "expo": {
    "name": "Translate+",
    "slug": "translate-plus",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.victor.translateplus",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Translate+ uses the microphone to translate speech.",
          "speechRecognitionPermission": "Translate+ uses speech recognition to translate speech.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Translate+ records a short sample to clone your voice."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Translate+ reads text from photos you choose.",
          "cameraPermission": "Translate+ reads text from photos you take."
        }
      ],
      "./plugins/with-share-text.js"
    ]
  }
}