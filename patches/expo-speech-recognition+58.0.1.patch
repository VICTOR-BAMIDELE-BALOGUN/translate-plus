+    private fun attachEffects(recorder: AudioRecord) {
+        val session = recorder.audioSessionId
+        fun add(effect: AudioEffect?) {
+            try {
+                effect?.enabled = true
+                effect?.let { effects.add(it) }
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not enable audio effect", e)
+            }
+        }
+        try {
+            if (noiseReduction && NoiseSuppressor.isAvailable()) add(NoiseSuppressor.create(session))
+            if (noiseReduction && AcousticEchoCanceler.isAvailable()) add(AcousticEchoCanceler.create(session))
+            if (boostQuietSpeech && AutomaticGainControl.isAvailable()) add(AutomaticGainControl.create(session))
+        } catch (e: Exception) {
+            Log.w(TAG, "Audio effects unavailable", e)
+        }
+    }
+
+    private fun releaseEffects() {
+        effects.forEach {
+            try {
+                it.release()
+            } catch (_: Exception) {}
+        }
+        effects.clear()
+    }
+
+    /** Raises quiet speech towards a normal level: drops fast on loud sound, rises slowly. */
+    private fun applyGain(data: ByteArray, length: Int) {
+        val samples = length / 2
+        if (samples == 0) return
+        var sum = 0.0
+        for (i in 0 until samples) {
+            val s = ((data[2 * i + 1].toInt() shl 8) or (data[2 * i].toInt() and 0xff)).toShort().toInt()
+            sum += (s * s).toDouble()
+        }
+        val rms = Math.sqrt(sum / samples)
+        if (rms >= SILENCE_RMS) {
+            val wanted = (TARGET_RMS / rms).toFloat().coerceIn(1.0f, MAX_GAIN)
+            gain = if (wanted < gain) wanted else gain + (wanted - gain) * 0.08f
+        }
+        if (gain <= 1.01f) return
+        for (i in 0 until samples) {
+            val s = ((data[2 * i + 1].toInt() shl 8) or (data[2 * i].toInt() and 0xff)).toShort().toInt()
